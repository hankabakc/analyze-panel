# ANALYZEPANEL — ortam değişkeni şablonu (T-069 / S-027)
#
# Bu dosya DEPODA DURUR ve gerçek değer içermez. Kopyalayıp doldurun:
#   cp .env.example .env
# .env dosyası git'e girmez (.gitignore).
#
# Canlıda uygulama `SPRING_PROFILES_ACTIVE=prod` ile çalışır. Aşağıdaki değişkenlerden
# biri eksikse uygulama açılmaz ve eksik değişkenin adını söyler.

# ---------------------------------------------------------------
# Veritabanı (docker-compose bu üçünü de kullanır)
# ---------------------------------------------------------------
DB_NAME=analyzepanel_db
DB_USER=analyzepanel
DB_PASSWORD=
DB_PORT=5433

# Uygulamanın veritabanına bağlanma adresi.
# docker-compose içinde servis adı kullanılır: jdbc:postgresql://postgres:5432/analyzepanel_db
DB_URL=jdbc:postgresql://postgres:5432/analyzepanel_db

# Eşzamanlı bağlantı sayısı. 200 kullanıcıya kadar 15 yeterli (S-027).
DB_POOL_SIZE=15

# ---------------------------------------------------------------
# Sırlar — her ortam için ayrı üretin, kimseyle paylaşmayın
# ---------------------------------------------------------------
# En az 64 karakter (HS512 algoritması için en az 512-bit). Üretmek için: openssl rand -base64 64
APPLICATION_SECURITY_JWT_SECRET_KEY=

# Kişisel verilerin şifrelenmesinde kullanılır. Tam 32 karakter olmalıdır.
# Üretmek için: openssl rand -hex 16
# DİKKAT: Bu anahtar değişirse eski şifreli veriler okunamaz.
PII_ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Uygulama
# ---------------------------------------------------------------
# Boş veritabanında açılan ilk yönetici hesabının e-postası.
# Güvenlik gereği şifre loglara basılmaz; kurulumdan hemen sonra şifrenizi almak için
# 'docker exec analyzepanel-backend java -jar app.jar --recover-admin=<email>' çalıştırın.
INITIAL_ADMIN_EMAIL=

# Tarayıcıdan istek atmasına izin verilen adres(ler), virgülle ayrılır.
# Canlıda yalnızca kendi alan adınız: https://ornekkurum.com
APP_CORS_ORIGINS=

# Karne PDF'lerinin saklanacağı dizin. Konteynerde kalıcı diske bağlanır.
APP_STORAGE_PATH=/var/lib/analyzepanel/uploads

# ---------------------------------------------------------------
# Hata izleme (Sentry)
# ---------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
